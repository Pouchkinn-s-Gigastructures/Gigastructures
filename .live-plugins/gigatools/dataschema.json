{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,

  "properties": {

    "tags": {
      "title": "List of tag categories",
      "type": "object",
      "default": {},
      "patternProperties": {
        "\\w+": {
          "title": "Tag Category",
          "type": "object",
          "patternProperties": {
            "\\w+": {
              "title": "Tag",
              "type": "object",
              "required": ["desc","fullDesc"],
              "properties": {
                "desc": {
                  "type": "string"
                },
                "fullDesc": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },

    "list_formats": {
      "title": "Formats for generated lists",
      "type": "object",
      "default": {},
      "patternProperties": {
        "\\w+": {
          "title": "Format Entry",
          "type": "object",
          "required": ["entry"],
          "properties": {
            "entry": {
              "type": "string"
            },
            "prefix": {
              "type": "string"
            },
            "suffix": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      }
    }
  }
}