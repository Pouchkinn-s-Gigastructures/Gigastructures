## MODEL

entity = {
	name = "giga_nomad_war_moon_frame_entity"
	pdxmesh = "giga_nomad_war_moon_frame_mesh"
	locator = { name = "part1" 		position = { 0  0 	0 } }

	default_state = "idle"
	state = { name = "idle" animation = "idle" looping = no animation_speed = 0.5 next_state = "idle" animation_blend_time = 0.5
		chance = {
			if_current_state = {
				"idle" = 100
				"moving" = 100
				"death" = 0
				"working" = 100
				"working_looping" = 0
			}
		}
	}
	state = { name = "moving" animation = "idle" looping = no animation_speed = 0.5 next_state = "moving" animation_blend_time = 0.5
		chance = {
			if_current_state = {
				"idle" = 100
				"moving" = 100
				"death" = 0
				"working" = 0
				"working_looping" = 0
			}
		}
	}
	state = { name = "working" animation = "working_start" looping = no animation_speed = 0.5 next_state = "working_looping"

	}
	state = { name = "working_looping" animation = "working_loop" looping = yes animation_speed = 0.5
		chance = {
			if_current_state = {
				"idle" = 0
				"moving" = 0
				"death" = 0
				"working" = 100
				"working_looping" = 100
			}
		}
	}
	state = { name = "idle" animation = "closing" animation_speed = 0.5 looping = no next_state = idle
		chance = {
			if_current_state = {
				"idle" = 0
				"moving" = 0
				"death" = 0
				"working" = 100
				"working_looping" = 100
			}
		}
	}
	state = { name = "death" animation = "death" looping = no animation_speed = 1
		chance = {
			if_current_state = {
				"idle" = 100
				"moving" = 100
				"death" = 0
				"working" = 0
				"working_looping" = 0
			}
		}
	}

	# game_data = {
	# 	size = 115
	# }
}

entity = {
	name = "giga_nomad_war_moon_ship_entity"
	pdxmesh = "giga_nomad_war_moon_mesh"
	locator = { name = "part1" 	position = { 0 0 0 } }

    default_state = "idle"
    state = { name = "idle" animation = "idle" looping = no animation_speed = 0.5 next_state = "idle" animation_blend_time = 0.5
		chance = {
			if_current_state = {
				"idle" = 100
				"moving" = 100
				"death" = 0
				"working" = 100
				"working_looping" = 0
			}
		}
		start_event = { trigger_once = yes sound = { soundeffect = military_arkship_idle_loop } }

		event = { time = 0.0 node = "engine_large_01" particle = "arkship_01_exhaust_1_circle_idle_effect" keep_particle = yes trigger_once = yes  }
		event = { time = 0.0 node = "engine_large_02" particle = "arkship_01_exhaust_1_circle_idle_effect" keep_particle = yes trigger_once = yes  }
		event = { time = 0.0 node = "engine_large_03" particle = "arkship_01_exhaust_1_circle_idle_effect" keep_particle = yes trigger_once = yes  }
		event = { time = 0.0 node = "engine_large_04" particle = "arkship_01_exhaust_1_circle_idle_effect" keep_particle = yes trigger_once = yes  }
		event = { time = 0.0 node = "engine_large_05" particle = "arkship_01_exhaust_1_circle_idle_effect" keep_particle = yes trigger_once = yes  }
		event = { time = 0.0 node = "engine_large_06" particle = "arkship_01_exhaust_1_circle_idle_effect" keep_particle = yes trigger_once = yes  }
	}

	state = { name = "moving" animation = "idle" looping = no animation_speed = 0.5 next_state = "moving" animation_blend_time = 0.5
		event = { time = 0.0 node = "engine_large_01" particle = "arkship_01_exhaust_1_moving_effect" keep_particle = yes trigger_once = yes  }
		event = { time = 0.0 node = "engine_large_02" particle = "arkship_01_exhaust_1_moving_effect" keep_particle = yes trigger_once = yes  }
		event = { time = 0.0 node = "engine_large_03" particle = "arkship_01_exhaust_1_moving_effect" keep_particle = yes trigger_once = yes  }
		event = { time = 0.0 node = "engine_large_04" particle = "arkship_01_exhaust_1_moving_effect" keep_particle = yes trigger_once = yes  }
		event = { time = 0.0 node = "engine_large_05" particle = "arkship_01_exhaust_1_moving_effect" keep_particle = yes trigger_once = yes  }
		event = { time = 0.0 node = "engine_large_06" particle = "arkship_01_exhaust_1_moving_effect" keep_particle = yes trigger_once = yes  }

		chance = {
			if_current_state = {
				"idle" = 100
				"moving" = 100
				"death" = 0
				"working" = 0
				"working_looping" = 0
			}
		}
		event = { trigger_once = yes sound = { soundeffect = military_arkship_move } }
	}


	# Opening state, goes into "working_looping" state when done.
	state = { name = "working" animation = "working_start" looping = no animation_speed = 0.5 next_state = "working_looping"
		event = { time = 0	id = "beam_start" }

		event = { time = 0.0 node = "engine_large_01" particle = "arkship_01_exhaust_1_circle_idle_effect" keep_particle = yes trigger_once = yes  }
		event = { time = 0.0 node = "engine_large_02" particle = "arkship_01_exhaust_1_circle_idle_effect" keep_particle = yes trigger_once = yes  }
		event = { time = 0.0 node = "engine_large_03" particle = "arkship_01_exhaust_1_circle_idle_effect" keep_particle = yes trigger_once = yes  }
		event = { time = 0.0 node = "engine_large_04" particle = "arkship_01_exhaust_1_circle_idle_effect" keep_particle = yes trigger_once = yes  }
		event = { time = 0.0 node = "engine_large_05" particle = "arkship_01_exhaust_1_circle_idle_effect" keep_particle = yes trigger_once = yes  }
		event = { time = 0.0 node = "engine_large_06" particle = "arkship_01_exhaust_1_circle_idle_effect" keep_particle = yes trigger_once = yes  }
	}

	# Opened state, going after "kill_moon".
	state = { name = "working_looping" animation = "working_loop" looping = yes animation_speed = 0.5
		event = { time = 0.0 node = "engine_large_01" particle = "arkship_01_exhaust_1_circle_idle_effect" keep_particle = yes trigger_once = yes  }
		event = { time = 0.0 node = "engine_large_02" particle = "arkship_01_exhaust_1_circle_idle_effect" keep_particle = yes trigger_once = yes  }
		event = { time = 0.0 node = "engine_large_03" particle = "arkship_01_exhaust_1_circle_idle_effect" keep_particle = yes trigger_once = yes  }
		event = { time = 0.0 node = "engine_large_04" particle = "arkship_01_exhaust_1_circle_idle_effect" keep_particle = yes trigger_once = yes  }
		event = { time = 0.0 node = "engine_large_05" particle = "arkship_01_exhaust_1_circle_idle_effect" keep_particle = yes trigger_once = yes  }
		event = { time = 0.0 node = "engine_large_06" particle = "arkship_01_exhaust_1_circle_idle_effect" keep_particle = yes trigger_once = yes  }

		chance = {
			if_current_state = {
				"idle" = 0
				"moving" = 0
				"death" = 0
				"working" = 100
				"working_looping" = 100
			}
		}
		event = { time = 1000 id = "beam_start" } #will never fire, but lets the game know that an event with this ID exists
		#	event = { time = 1.5  sound = { soundeffect = kaiju_adult_pre_chomp stop_on_state_change = yes } }
	}

	# Idle state when going from opened state to idle.
	state = { name = "idle" animation = "closing" animation_speed = 0.5 looping = no next_state = idle
		chance = {
			if_current_state = {
				"idle" = 0
				"moving" = 0
				"death" = 0
				"working" = 100
				"working_looping" = 100
			}
		}
		event = { time = 9.0 sound = { soundeffect = ship_hatch_open } }
		event = { time = 0.0 node = "engine_large_01" particle = "arkship_01_exhaust_1_circle_idle_effect" keep_particle = yes trigger_once = yes  }
		event = { time = 0.0 node = "engine_large_02" particle = "arkship_01_exhaust_1_circle_idle_effect" keep_particle = yes trigger_once = yes  }
		event = { time = 0.0 node = "engine_large_03" particle = "arkship_01_exhaust_1_circle_idle_effect" keep_particle = yes trigger_once = yes  }
		event = { time = 0.0 node = "engine_large_04" particle = "arkship_01_exhaust_1_circle_idle_effect" keep_particle = yes trigger_once = yes  }
		event = { time = 0.0 node = "engine_large_05" particle = "arkship_01_exhaust_1_circle_idle_effect" keep_particle = yes trigger_once = yes  }
		event = { time = 0.0 node = "engine_large_06" particle = "arkship_01_exhaust_1_circle_idle_effect" keep_particle = yes trigger_once = yes  }

	}

	# Closed death state.
	state = { name = "death" animation = "death" looping = no animation_speed = 1

		chance = {
			if_current_state = {
				"idle" = 100
				"moving" = 100
				"death" = 0
				"working" = 0
				"working_looping" = 0
			}
		}
	}

	game_data = {
		emissive_recolor_crunch = 3.0
	}
}

animation = {
	name = "giga_nomad_war_moon_idle_animation"
	file = "giga_nomad_war_moon_idle.anim"
}
animation = {
	name = "giga_nomad_war_moon_frame_idle_animation"
	file = "giga_nomad_war_moon_frame_idle.anim"
}

